<connectionStrings>
  <add name="Sqlconn" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SCMS_SF;Integrated Security=True;MultipleActiveResultSets=true;TrustServerCertificate=True;Connect Timeout=30;"
    providerName="System.Data.SqlClient" />
  <add name="School.Properties.Settings.SchoolConnectionString"
